# Binaires compilés
/simulate
/simulate.exe
*.exe
*.test

# Artefacts de profilage — régénérables, jamais versionnés
*.prof
*.out
cpu.out
mem.out
block.out
mutex.out
trace.out
*.pprof
/profiles/

# Résultats de mesure bruts, régénérables.
# baseline.txt est l'exception : c'est la mesure de référence du projet,
# elle doit être versionnée pour que les comparaisons benchstat soient
# reproductibles par un tiers.
# Les mesures de reference sont versionnees : sans elles, aucune comparaison
# benchstat n'est reproductible par un tiers.
!/bench/*.txt
/bench/*.json

# Couverture
coverage.out
coverage.html

# Environnements
.env
.DS_Store
