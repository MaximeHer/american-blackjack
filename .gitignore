# Binaires compilés
/simulate
/simulate.exe
*.exe
*.test

# Artefacts de profilage — régénérables, jamais versionnés
*.prof
*.out
cpu.out
mem.out
block.out
mutex.out
trace.out
*.pprof
# Les profils sont regenerables et dependent du materiel : seules leurs
# conclusions sont versionnees, dans docs/03-profiling.md.
/profiles/

# Résultats de mesure bruts, régénérables.
# baseline.txt est l'exception : c'est la mesure de référence du projet,
# elle doit être versionnée pour que les comparaisons benchstat soient
# reproductibles par un tiers.
# Les mesures de reference sont versionnees : sans elles, aucune comparaison
# benchstat n'est reproductible par un tiers.
!/bench/*.txt
/bench/*.json

# Dossiers de mesure horodates, produits par le harnais. Regenerables, et
# contenant des binaires : seul leur resume merite d'etre cite dans le rapport.
/results/

# Couverture
coverage.out
coverage.html

# Environnements
.env
.DS_Store
